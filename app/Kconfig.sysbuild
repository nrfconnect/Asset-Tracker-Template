choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if !BOARD_NATIVE_SIM
endchoice

config NCS_MCUBOOT_LOAD_PERIPHCONF
	default y if BOARD_NRF9251DK_NRF9251_CPUAPP

config SECURE_BOOT_APPCORE
	default y if BOARD_NRF9151DK_NRF9151_NS

# Shared NSIB (b0) signing key for all ATT sysbuild targets. Sysbuild signs images with this
# key; b0 verifies them. Without this, sysbuild autogenerates a new debug key on each pristine
# build. Not for production.
config SECURE_BOOT_SIGNING_KEY_FILE
	default "$(ZEPHYR_NRF_MODULE_DIR)/boards/nordic/thingy91x/nsib_signing_key.pem"

config WIFI_NRF70
	default y if BOARD_THINGY91X_NRF9151_NS

choice WIFI_NRF70_OPER_MODES
	default WIFI_NRF70_SCAN_ONLY if BOARD_THINGY91X_NRF9151_NS
endchoice

config LAUNCH_PPR
	bool "Launch the PPR core and forward its logs to the application core over IPC"
	depends on SUPPORT_PPRCORE
	help
	  Builds app/ppr as the PPR core image, launches it from the application
	  core, and forwards its log output over IPC (icmsg-me) to the application
	  core's log backends.

if SUPPORT_PPRCORE

choice PPRCORE
	default PPRCORE_REMOTE if LAUNCH_PPR

config PPRCORE_REMOTE
	bool "ATT PPR image"
	depends on LAUNCH_PPR

endchoice

config PPRCORE_IMAGE_NAME
	default "ppr" if PPRCORE_REMOTE

config PPRCORE_IMAGE_PATH
	default "$(APP_DIR)/ppr" if PPRCORE_REMOTE

endif # SUPPORT_PPRCORE

source "${ZEPHYR_BASE}/share/sysbuild/Kconfig"
