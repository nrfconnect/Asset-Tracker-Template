/*
 * nRF9251 counterpart of overlay-upload-modem-traces-to-memfault.overlay. Pair with
 * overlay-upload-modem-traces-to-memfault.conf.
 *
 * The trace UART and shared memory region mirror the nrf92-modem-trace-uart snippet
 * (nrf/snippets/nrf92-modem-trace-uart).
 */

/* Used by the modem_trace dump_uart shell command. */
&uart132 {
	status = "okay";
	current-speed = <1000000>;
	memory-regions = <&cpuapp_dma_region>;
};

/ {
	chosen {
		nordic,modem-trace-uart = &uart132;
	};
};

/delete-node/ &cpuapp_cpucell_ipc_shm_ctrl;
/delete-node/ &cpuapp_cpucell_ipc_shm_heap;
/delete-node/ &cpucell_cpuapp_ipc_shm_heap;

/* Reduce size of application RAM to make room for trace. */
&cpuapp_ram0x_sram {
	reg = <0x2f000000 DT_SIZE_K(332)>;
	ranges = <0x0 0x2f000000 0x53000>;
};

&cpuapp_cpucell_ram0x_region {
	/* Move IPC shared memory and add trace region. */
	cpuapp_cpucell_ipc_shm_ctrl: memory@3000 {
		reg = <0x3000 DT_SIZE_K(4)>;
	};

	cpuapp_cpucell_ipc_shm_heap: memory@4000 {
		reg = <0x4000 DT_SIZE_K(16)>;
	};

	cpucell_cpuapp_ipc_shm_heap: memory@8000 {
		reg = <0x8000 DT_SIZE_K(16)>;
	};

	cpucell_cpuapp_ipc_shm_trace: memory@c000 {
		reg = <0xc000 DT_SIZE_K(16)>;
	};
};

/delete-node/ &external_flash_partition;

&flash_ext {
	partitions {
		modem_trace: partition@500000 {
			label = "modem_trace";
			reg = <0x00500000 0x000ff000>;
		};

		external_flash_partition: partition@5ff000 {
			label = "external_flash";
			reg = <0x005ff000 0x01a01000>;
		};
	};
};
